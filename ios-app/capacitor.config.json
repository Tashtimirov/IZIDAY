{
  "appId": "com.tashtimirov.izi",
  "appName": "IZIDAY",
  "webDir": "www",
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#F2F2F7",
    "limitsNavigationsToAppBoundDomains": false
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "launchShowDuration": 400,
      "backgroundColor": "#F2F2F7"
    },
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    }
  }
}
